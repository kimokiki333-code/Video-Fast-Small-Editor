{
  "id": "./",
  "name": "Make it Fast Edit Arsenal",
  "short_name": "Fast Arsenal",
  "description": "Full-scale black-out video workstation: trim, free crop, text, MP3-to-MP4, splitter, effects and rapid exports, entirely on-device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": [
    "productivity",
    "photo",
    "utilities"
  ],
  "lang": "en",
  "icons": [
    {
      "src": "./assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Open edit arsenal",
      "short_name": "Edit",
      "url": "./?tool=trim",
      "icons": [
        {
          "src": "./assets/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "MP3 to MP4",
      "short_name": "MP3 → MP4",
      "url": "./?tool=audio",
      "icons": [
        {
          "src": "./assets/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
